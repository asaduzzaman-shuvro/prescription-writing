    "seed:labs": "tsx src/scripts/seed-labs.ts",
    "bench:search": "tsx src/scripts/bench-search.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@rx/core": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.9",
    "csv-parse": "^6.1.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"

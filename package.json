{
  "name": "prescription-writing",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter @rx/db migrate",
    "db:migrate:cpanel": "pnpm --filter @rx/db exec tsx src/scripts/migrate-cpanel.ts",
    "db:seed:dev": "pnpm --filter @rx/db seed:dev",
    "db:seed:labs": "pnpm --filter @rx/db seed:labs"
  },
  "devDependencies": {
    "turbo": "^2.11.7",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "sharp", "@tailwindcss/oxide", "unrs-resolver"]
  }
}

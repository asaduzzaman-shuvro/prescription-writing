# Owner connection (migrations, platform admin)
DATABASE_URL=postgres://rx:rx@localhost:5433/rx
# Row-level-security connection used for clinic users
DATABASE_URL_APP=postgres://rx_app:rx_app@localhost:5433/rx
# Session cookie signing secret (min 32 chars)
SESSION_SECRET=change-me-to-a-long-random-string-of-32-chars
# Public base URL used in QR verification links
PUBLIC_BASE_URL=http://localhost:3000

# PowerSync (must match infra/.env PS_JWT_SECRET)
POWERSYNC_URL=http://localhost:8080
POWERSYNC_JWT_SECRET=generate-with-openssl-rand-32-base64url
POWERSYNC_JWT_KID=powersync-dev
# Reserved for a future sync history window (JWT claim sync_since). PowerSync rules cannot use >= on auth params yet; leave 0.
POWERSYNC_SYNC_DAYS=0

# SMS (BTRC-authorised gateway). console = log only
SMS_PROVIDER=console
SMS_HTTP_URL=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_HTTP_SUCCESS=
# Optional email HTTP gateway for password-reset links when no mobile is on file
EMAIL_HTTP_URL=
EMAIL_API_KEY=
EMAIL_HTTP_METHOD=POST
# Bearer token for /api/cron/* jobs
CRON_SECRET=dev-cron-secret

# SSLCommerz online payment (cards, bKash, Nagad). Leave empty to disable.
SSLCZ_STORE_ID=
SSLCZ_STORE_PASSWORD=
SSLCZ_SANDBOX=true
